{
  "manifest_version": 3,
  "name": "SearchDeck",
  "version": "1.0.0",
  "description": "Type one search term and open it on a whole deck of websites at once.",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "SearchDeck",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabGroups", "favicon"],
  "omnibox": {
    "keyword": "sd"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open SearchDeck"
    }
  }
}
